# macOS
.DS_Store
**/.DS_Store

# Xcode
*.xcuserstate
xcuserdata/
*.xcuserdata/

# Build artifacts
build/
DerivedData/
*.pcm
*.swiftdeps
*.o

# Claude Code worktrees
.claude/worktrees/

# Audit snapshots (T's local records)
audit-*.json

# Historical corpus snapshots (T's local records)
corpus_index.pre-*.json

# SwiftPM build artifacts (harness sub-packages)
.build/
Package.resolved

# Python bytecode (scripts/ helpers)
scripts/__pycache__/

# Local experiment spikes — not part of the shipping app
spikes/

# Kokoro TTS spike — the model weights + voice styles are huge, dev-only, and
# placed by hand (see AirPad/Resources/Kokoro/README-DROP-MODEL-HERE.txt).
# The README stays tracked; the assets never get committed.
AirPad/Resources/Kokoro/*.safetensors
AirPad/Resources/Kokoro/*.npz

# TestFlight / App Store Connect secrets — NEVER commit
*.p8
.testflight.env
testflight.env
scripts/testflight.env
# (scripts/testflight.env.example IS committed — it's a no-secret template)
!scripts/testflight.env.example
