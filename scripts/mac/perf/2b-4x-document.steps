# Sweep 2b · 4.2 / 4.3 / 4.4 on a DOCUMENT — same as 2b-4x-photos.steps, on the first test-library entry with a PDF:
#   EXTRA="-Sweep4Log YES -Open4x document -Open4xDelay 18"
# grade: python3 scripts/mac/perf/4x/grade4x.py <run dir> document
open-wait      wait 8000
search         click toolbar.search
search-type    type light
rest           wait 2000
reveal         reveal documentOpen-*#0
# T's state: the entry was opened under a focused search; a click on the item (Quick Look, closed again) is the click
# that takes the keys from the field (sweep 2b · 4.1: Finder's model; without it Space types into the search, by design).
search-away    click documentOpen-*#0
search-rest    wait 2500
search-away2   esc
search-rest2   wait 1500
h1-hover0      move documentOpen-*#0 0 0 1
h2-rest        wait 1000
q1-space       key 49
rest           wait 3000
q3-space       key 49
rest           wait 2000
q4-click       click documentOpen-*#0
rest           wait 3000
q5-esc         esc
rest           wait 2000
o1-hover       move documentOpen-*#0 0 0 1
rest           wait 500
o1-cmdO        cmdkey 31
rest           wait 4000
