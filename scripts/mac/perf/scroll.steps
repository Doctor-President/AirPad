# K3 — scrolling and panning only, for Instruments' Animation Hitches (frame times at the display's 120 Hz).
library      click sidebar.library
view-list    click toolbar.view.List
list-scroll  scroll 640,600 -2400 80 8
list-scroll  scroll 640,600 2400 80 8
list-scroll  scroll 640,600 -2400 80 8
list-scroll  scroll 640,600 2400 80 8
