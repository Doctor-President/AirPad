# AirPad TestFlight credentials — TEMPLATE (safe to commit; no secrets).
#
# Copy to a REAL, gitignored location and fill in:
#   mkdir -p ~/.config/airpad
#   cp scripts/testflight.env.example ~/.config/airpad/testflight.env
#   # then edit ~/.config/airpad/testflight.env
#
# The upload script loads the first it finds (real env vars override):
#   $AIRPAD_TF_CONFIG  ->  ~/.config/airpad/testflight.env  ->  ./.testflight.env
#
# The .p8 is the only true secret — keep it out of the repo (e.g. ~/.appstore).
# The API key needs "App Manager" (or Admin) access so xcodebuild can create the
# distribution certificate + App Store profile on the first run.

# Key ID (10 chars) shown next to the key in App Store Connect.
ASC_KEY_ID=XXXXXXXXXX

# Issuer ID (UUID) at the top of the Integrations / Keys page.
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Absolute path (or ~-path) to the downloaded key. altool expects the file to be
# named AuthKey_<ASC_KEY_ID>.p8.
ASC_KEY_PATH=~/.appstore/AuthKey_XXXXXXXXXX.p8

# App Store Connect app record id (from the URL). Optional; not used by altool.
ASC_APP_ID=0000000000
